camera.rotation.order = 'YXZ';
scene.add(camera);
function resize() { const w = window.innerWidth, h = window.innerHeight; renderer.setSize(w, h, false); camera.aspect = w / h; camera.updateProjectionMatrix(); }
function applyPixelRatio() { renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, PR[SET.quality] || 1.5)); resize(); }
renderer.outputColorSpace = THREE.SRGBColorSpace;
canvas.addEventListener('webglcontextlost', (e) => { e.preventDefault(); log('WebGL context lost'); showFade('…', 'Графика перезапускается'); });
canvas.addEventListener('webglcontextrestored', () => location.reload());
window.addEventListener('resize', resize); applyPixelRatio();

