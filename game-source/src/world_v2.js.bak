import * as THREE from 'three';
import { mergeGeometries } from 'three/examples/jsm/utils/BufferGeometryUtils.js';

export const CS = 2;          // размер клетки, м
export const W = 22, H = 18;  // клеток по X и Z
export const FLOOR_Y = [-3, 0, 3]; // подвал, первый этаж, второй этаж

// ---------- карта ----------
// '#' стена  '.' пол  'c' скрипучий пол  'D' дверь  'L' запертая дверь  'H' тайный стеллаж
// 'S' лестница  'W' шкаф  'B' кровать  'T' мебель  'g' трава  'f' забор
// 'G' ворота  'r' рельсы  'R' дрезина  'Y' дерево  'w' вода  ' ' пусто
function grid(ch) { const g = []; for (let z = 0; z < H; z++) g.push(new Array(W).fill(ch)); return g; }
function rect(g, x0, z0, x1, z1, ch) { for (let z = z0; z <= z1; z++) for (let x = x0; x <= x1; x++) g[z][x] = ch; }
function put(g, list, ch) { for (const [x, z] of list) g[z][x] = ch; }

export function buildMaps() {
  // Подвал
  const g0 = grid('#');
  put(g0, [[15, 11], [15, 12], [15, 13]], 'S');
  rect(g0, 15, 14, 15, 15, '.');
  rect(g0, 5, 15, 15, 15, '.');
  rect(g0, 11, 6, 11, 14, '.');
  rect(g0, 8, 3, 13, 5, '.');
  rect(g0, 7, 11, 7, 14, '.');
  rect(g0, 4, 8, 8, 10, '.');
  rect(g0, 4, 11, 4, 16, '.');
  rect(g0, 2, 3, 3, 17, 'w');
  put(g0, [[13, 3], [8, 3]], 'T');
  // тайная комната за стеллажом
  g0[4][14] = 'H';
  rect(g0, 15, 3, 18, 5, '.');
  put(g0, [[18, 4]], 'T');

  // Первый этаж и двор
  const g1 = grid('g');
  for (let x = 0; x < W; x++) { g1[0][x] = 'f'; g1[H - 1][x] = 'f'; }
  for (let z = 0; z < H; z++) { g1[z][0] = 'f'; g1[z][W - 1] = 'f'; }
  g1[0][9] = 'G';
  for (let z = 0; z <= 16; z++) g1[z][20] = 'r';
  g1[13][20] = 'R';
  put(g1, [[4, 1], [15, 1], [1, 9], [5, 16], [13, 16]], 'Y');
  rect(g1, 2, 3, 17, 14, '#');
  rect(g1, 3, 4, 6, 6, '.'); rect(g1, 8, 4, 10, 6, '.'); rect(g1, 12, 4, 16, 6, '.');
  rect(g1, 3, 8, 16, 9, '.');
  rect(g1, 3, 11, 6, 13, '.'); rect(g1, 8, 11, 8, 13, '.');
  put(g1, [[9, 12], [10, 12], [11, 12], [15, 11], [15, 12], [15, 13]], 'S');
  put(g1, [[9, 3], [5, 7], [14, 7], [5, 10], [8, 10]], 'D');
  g1[7][9] = '.';
  g1[10][15] = 'L';
  put(g1, [[10, 8], [4, 9], [13, 9], [9, 5]], 'c');
  put(g1, [[4, 5], [3, 4], [14, 5], [6, 13]], 'T');
  put(g1, [[16, 4], [8, 4], [8, 13], [16, 9]], 'W');
  put(g1, [[3, 13]], 'B');

  // Второй этаж
  const g2 = grid(' ');
  rect(g2, 2, 3, 17, 14, '#');
  rect(g2, 3, 4, 6, 6, '.'); rect(g2, 8, 4, 10, 6, '.'); rect(g2, 12, 4, 16, 6, '.');
  rect(g2, 3, 8, 16, 9, '.');
  rect(g2, 3, 11, 6, 13, '.'); rect(g2, 12, 11, 12, 13, '.'); rect(g2, 14, 11, 16, 13, '.');
  put(g2, [[9, 12], [10, 12], [11, 12]], 'S');
  put(g2, [[5, 7], [14, 7], [5, 10], [15, 10]], 'D');
  g2[7][9] = '.'; g2[10][12] = '.';
  g2[3][9] = 'L';
  rect(g2, 8, 2, 10, 2, '.');
  put(g2, [[7, 8], [11, 9], [15, 8]], 'c');
  put(g2, [[3, 6], [16, 6], [16, 13]], 'T');
  put(g2, [[6, 4], [6, 11], [3, 9]], 'W');
  put(g2, [[3, 4], [12, 4], [3, 13]], 'B');

  return [g0, g1, g2];
}

// Вид мебели в клетках 'T'
export const FURN_TYPE = {
  '1,3,4': 'stove', '1,4,5': 'table', '1,14,5': 'table', '1,6,13': 'desk',
  '2,3,6': 'dresser', '2,16,6': 'dresser', '2,16,13': 'tub',
  '0,13,3': 'bench', '0,8,3': 'bench', '0,18,4': 'chest',
};
// Комнаты с плиткой на полу
const TILE_ROOMS = [[1, 3, 4, 6, 6], [2, 14, 11, 16, 13]];

// Лестницы: y = FLOOR_Y[low] на координате a, FLOOR_Y[high] на координате b
export const RAMPS = [
  { cells: [[9, 12], [10, 12], [11, 12]], low: 1, high: 2, axis: 'x', a: 9 * CS, b: 12 * CS },
  { cells: [[15, 11], [15, 12], [15, 13]], low: 0, high: 1, axis: 'z', a: 14 * CS, b: 11 * CS },
];
export function rampAt(cx, cz) {
  for (const r of RAMPS) for (const [x, z] of r.cells) if (x === cx && z === cz) return r;
  return null;
}
export function rampY(r, x, z) {
  const c = r.axis === 'x' ? x : z;
  let t = (c - r.a) / (r.b - r.a);
  t = Math.max(0, Math.min(1, t));
  return FLOOR_Y[r.low] + t * (FLOOR_Y[r.high] - FLOOR_Y[r.low]);
}
export function insideHouse(cx, cz) { return cx >= 2 && cx <= 17 && cz >= 3 && cz <= 14; }

// ---------- текстуры ----------
function rng(seed) { return function () { seed |= 0; seed = seed + 0x6D2B79F5 | 0; let t = Math.imul(seed ^ seed >>> 15, 1 | seed); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }
let ANISO = 4, LOW = false;
export function setAniso(a) { ANISO = a; }
// рисуем в полном размере, на слабой графике уменьшаем вдвое — в 4 раза меньше памяти
function tex(w, h, draw, seed = 1, opts = {}) {
  let c = document.createElement('canvas'); c.width = w; c.height = h;
  const g = c.getContext('2d'); const R = rng(seed);
  draw(g, w, h, R);
  if (LOW && w >= 128) {
    const s = document.createElement('canvas'); s.width = w / 2; s.height = h / 2;
    s.getContext('2d').drawImage(c, 0, 0, w / 2, h / 2); c.width = c.height = 0; c = s;
  }
  const t = new THREE.CanvasTexture(c);
  t.wrapS = t.wrapT = THREE.RepeatWrapping;
  t.anisotropy = ANISO;
  if (!opts.data) t.colorSpace = THREE.SRGBColorSpace;
  return t;
}
function noise(g, w, h, R, n, cols, a, size = 2) {
  for (let i = 0; i < n; i++) {
    g.fillStyle = cols[(R() * cols.length) | 0]; g.globalAlpha = a * R();
    const s = 1 + R() * size; g.fillRect(R() * w, R() * h, s, s);
  }
  g.globalAlpha = 1;
}
function stain(g, x, y, r, col, a) {
  const gr = g.createRadialGradient(x, y, 0, x, y, r);
  gr.addColorStop(0, col); gr.addColorStop(1, 'rgba(0,0,0,0)');
  g.globalAlpha = a; g.fillStyle = gr; g.fillRect(x - r, y - r, r * 2, r * 2); g.globalAlpha = 1;
}
function crack(g, R, x, y, len, col) {
  g.strokeStyle = col; g.lineWidth = 1; g.beginPath(); g.moveTo(x, y);
  for (let i = 0; i < len; i++) { x += R() * 8 - 4; y += R() * 6 + 2; g.lineTo(x, y); }
  g.stroke();
}
// дамасский узор
function damask(g, x, y, s, col) {
  g.fillStyle = col; g.beginPath();
  g.moveTo(x, y - s); g.bezierCurveTo(x + s * 0.7, y - s * 0.6, x + s * 0.6, y + s * 0.2, x, y + s);
  g.bezierCurveTo(x - s * 0.6, y + s * 0.2, x - s * 0.7, y - s * 0.6, x, y - s); g.fill();
  g.beginPath(); g.arc(x, y - s * 0.15, s * 0.22, 0, 7); g.fillStyle = 'rgba(0,0,0,0.25)'; g.fill();
  g.fillStyle = col;
  g.fillRect(x - s * 0.9, y - 1, s * 1.8, 2);
}
function wallTex(base, pat, panel, seed) {
  return tex(256, 384, (g, w, h, R) => {
    g.fillStyle = base; g.fillRect(0, 0, w, h);
    // обои
    for (let y = 30; y < 280; y += 52) for (let x = (y / 52 % 2) * 32; x < w + 32; x += 64) damask(g, x, y, 15, pat);
    for (let x = 0; x < w; x += 64) { g.fillStyle = 'rgba(0,0,0,0.12)'; g.fillRect(x, 0, 2, 280); }
    noise(g, w, 280, R, 2500, ['#000', '#fff'], 0.08);
    stain(g, R() * w, 60 + R() * 100, 40 + R() * 40, 'rgba(60,40,10,1)', 0.25);
    stain(g, R() * w, 200 + R() * 60, 30, 'rgba(20,15,5,1)', 0.3);
    // отклеившийся угол
    g.fillStyle = 'rgba(0,0,0,0.35)'; g.beginPath(); g.moveTo(w - 40, 0); g.lineTo(w, 0); g.lineTo(w, 50); g.fill();
    // карниз
    g.fillStyle = '#2a1d14'; g.fillRect(0, 0, w, 10); g.fillStyle = '#4a3828'; g.fillRect(0, 10, w, 3);
    // деревянные панели
    g.fillStyle = panel; g.fillRect(0, 270, w, h - 270);
    g.fillStyle = '#1e140c'; g.fillRect(0, 268, w, 6);
    for (let x = 6; x < w; x += 64) {
      g.strokeStyle = 'rgba(0,0,0,0.45)'; g.lineWidth = 3; g.strokeRect(x + 4, 284, 52, 76);
      g.strokeStyle = 'rgba(255,220,180,0.08)'; g.lineWidth = 1; g.strokeRect(x + 7, 287, 46, 70);
    }
    for (let y = 274; y < h; y += 3) { g.fillStyle = `rgba(0,0,0,${R() * 0.12})`; g.fillRect(0, y, w, 1); }
    g.fillStyle = '#140d07'; g.fillRect(0, h - 12, w, 12);
    noise(g, w, h, R, 400, ['#000'], 0.3, 3);
  }, seed);
}

export function makeTextures(quality) {
  setAniso(quality === 'low' ? 1 : quality === 'medium' ? 2 : 4); LOW = quality === 'low';
  const T = {};
  T.wall1 = wallTex('#3c4a30', '#4f5e3c', '#3f2a1a', 11);
  T.wall2 = wallTex('#5a3a3a', '#6e4747', '#35231a', 22);
  T.planks = tex(256, 256, (g, w, h, R) => {
    for (let y = 0; y < h; y += 32) {
      let x = -R() * 120;
      while (x < w) {
        const len = 90 + R() * 120, v = 62 + R() * 26;
        g.fillStyle = `rgb(${v | 0},${v * 0.64 | 0},${v * 0.4 | 0})`; g.fillRect(x, y, len, 32);
        for (let k = 0; k < 9; k++) { g.strokeStyle = `rgba(30,15,5,${0.15 + R() * 0.2})`; g.beginPath(); const yy = y + 3 + k * 3.2; g.moveTo(x, yy); for (let s = 0; s < len; s += 10) g.lineTo(x + s, yy + Math.sin((s + k * 13) * 0.05) * 1.5); g.stroke(); }
        if (R() < 0.3) { g.fillStyle = 'rgba(20,10,4,0.6)'; g.beginPath(); g.ellipse(x + R() * len, y + 16, 5, 3, 0, 0, 7); g.fill(); }
        g.fillStyle = '#120a05'; g.fillRect(x, y, 2, 32);
        g.fillStyle = '#2a1a0e'; g.fillRect(x + 6, y + 6, 2, 2); g.fillRect(x + 6, y + 24, 2, 2);
        x += len;
      }
      g.fillStyle = '#0e0703'; g.fillRect(0, y, w, 2);
    }
    noise(g, w, h, R, 1500, ['#000', '#3a2a1a'], 0.25);
    stain(g, 80, 160, 50, 'rgba(10,5,0,1)', 0.35);
  }, 3);
  T.tile = tex(256, 256, (g, w, h, R) => {
    g.fillStyle = '#2b2620'; g.fillRect(0, 0, w, h);
    for (let y = 0; y < 8; y++) for (let x = 0; x < 8; x++) {
      const dark = (x + y) % 2; const v = dark ? 40 + R() * 10 : 150 + R() * 25;
      g.fillStyle = dark ? `rgb(${v * 0.6 | 0},${v | 0},${v * 0.95 | 0})` : `rgb(${v | 0},${v * 0.95 | 0},${v * 0.82 | 0})`;
      g.fillRect(x * 32 + 1, y * 32 + 1, 30, 30);
    }
    for (let i = 0; i < 6; i++) crack(g, R, R() * w, R() * h, 5, 'rgba(0,0,0,0.6)');
    noise(g, w, h, R, 2500, ['#000', '#4a3a20'], 0.25);
    stain(g, 170, 90, 60, 'rgba(40,30,10,1)', 0.35);
  }, 31);
  T.ceil = tex(256, 256, (g, w, h, R) => {
    g.fillStyle = '#6e695f'; g.fillRect(0, 0, w, h);
    noise(g, w, h, R, 4000, ['#4a463e', '#8a857a'], 0.35);
    stain(g, 70, 80, 70, 'rgba(90,65,20,1)', 0.35); stain(g, 190, 180, 50, 'rgba(60,40,10,1)', 0.3);
    for (let i = 0; i < 4; i++) crack(g, R, R() * w, R() * 60, 12, 'rgba(30,25,20,0.7)');
    g.fillStyle = 'rgba(0,0,0,0.25)'; g.fillRect(0, 0, w, 4); g.fillRect(0, 0, 4, h);
  }, 4);
  T.brick = tex(256, 256, (g, w, h, R) => {
    g.fillStyle = '#1e1813'; g.fillRect(0, 0, w, h);
    for (let y = 0; y < h; y += 21) for (let x = ((y / 21) % 2) * 26 - 26; x < w; x += 52) {
      const v = 70 + R() * 40; g.fillStyle = `rgb(${v | 0},${v * 0.42 | 0},${v * 0.32 | 0})`;
      g.fillRect(x + 2, y + 2, 48, 17);
      g.fillStyle = 'rgba(255,200,150,0.08)'; g.fillRect(x + 2, y + 2, 48, 3);
      g.fillStyle = 'rgba(0,0,0,0.25)'; g.fillRect(x + 2, y + 16, 48, 3);
    }
    noise(g, w, h, R, 3000, ['#000', '#2a2018'], 0.4);
    // плесень и потёки
    for (let i = 0; i < 6; i++) { const x = R() * w; g.fillStyle = 'rgba(10,20,8,0.35)'; g.fillRect(x, 0, 3 + R() * 6, 40 + R() * 120); }
    stain(g, 128, 230, 100, 'rgba(20,40,15,1)', 0.45);
  }, 5);
  T.stone = tex(256, 256, (g, w, h, R) => {
    g.fillStyle = '#1a1816'; g.fillRect(0, 0, w, h);
    for (let y = 0; y < h; y += 64) for (let x = ((y / 64) % 2) * 40 - 40; x < w; x += 80) {
      const v = 55 + R() * 30; g.fillStyle = `rgb(${v | 0},${v | 0},${v - 6 | 0})`;
      g.beginPath(); g.roundRect ? g.roundRect(x + 3, y + 3, 74, 58, 8) : g.rect(x + 3, y + 3, 74, 58); g.fill();
    }
    noise(g, w, h, R, 4000, ['#000', '#5a5650'], 0.35);
    stain(g, 60, 190, 70, 'rgba(10,25,25,1)', 0.5);
  }, 6);
  T.grass = tex(256, 256, (g, w, h, R) => {
    g.fillStyle = '#16220f'; g.fillRect(0, 0, w, h);
    for (let i = 0; i < 2500; i++) { const x = R() * w, y = R() * h; g.strokeStyle = R() < 0.5 ? '#2a4220' : '#0c1408'; g.globalAlpha = 0.6; g.beginPath(); g.moveTo(x, y); g.lineTo(x + R() * 4 - 2, y - 4 - R() * 5); g.stroke(); }
    g.globalAlpha = 1; stain(g, 90, 90, 60, 'rgba(40,30,15,1)', 0.4);
  }, 7);
  const siding = (win) => tex(256, 384, (g, w, h, R) => {
    for (let y = 0; y < h; y += 24) { const v = 50 + R() * 16; g.fillStyle = `rgb(${v | 0},${v - 5 | 0},${v - 10 | 0})`; g.fillRect(0, y, w, 24); g.fillStyle = 'rgba(0,0,0,0.6)'; g.fillRect(0, y + 21, w, 3); g.fillStyle = 'rgba(255,255,255,0.05)'; g.fillRect(0, y, w, 2); }
    noise(g, w, h, R, 2500, ['#000'], 0.3);
    for (let i = 0; i < 8; i++) { g.fillStyle = 'rgba(0,0,0,0.3)'; g.fillRect(R() * w, 0, 2, h); }
    if (win) {
      g.fillStyle = '#1a1008'; g.fillRect(60, 80, 136, 190);
      g.fillStyle = '#3a2614'; g.fillRect(52, 270, 152, 14);
      const gr = g.createLinearGradient(0, 90, 0, 260); gr.addColorStop(0, '#d8a85a'); gr.addColorStop(1, '#7a4a1a');
      g.fillStyle = gr; g.fillRect(70, 90, 116, 170);
      g.fillStyle = 'rgba(0,0,0,0.55)'; g.fillRect(70, 90, 116, 170);
      g.fillStyle = '#1a1008'; g.fillRect(124, 90, 8, 170); g.fillRect(70, 170, 116, 8);
      // доски крест-накрест
      g.save(); g.translate(128, 175); g.rotate(0.55); g.fillStyle = '#4a321c'; g.fillRect(-100, -9, 200, 18); g.rotate(-1.1); g.fillRect(-100, -9, 200, 18); g.restore();
    }
  }, win ? 9 : 8);
  T.siding = siding(false); T.window = siding(true);
  T.fence = tex(128, 128, (g, w, h, R) => {
    for (let x = 0; x < w; x += 16) { const v = 50 + R() * 20; g.fillStyle = `rgb(${v | 0},${v * 0.75 | 0},${v * 0.5 | 0})`; g.fillRect(x, 0, 14, h); g.fillStyle = 'rgba(0,0,0,0.6)'; g.fillRect(x + 14, 0, 2, h); }
    noise(g, w, h, R, 800, ['#000'], 0.35);
  }, 10);
  T.water = tex(256, 256, (g, w, h, R) => { g.fillStyle = '#071214'; g.fillRect(0, 0, w, h); for (let i = 0; i < 300; i++) { g.strokeStyle = `rgba(80,140,140,${R() * 0.25})`; g.beginPath(); const x = R() * w, y = R() * h; g.moveTo(x, y); g.quadraticCurveTo(x + 10, y - 3, x + 20, y); g.stroke(); } }, 12);
  T.roof = tex(256, 256, (g, w, h, R) => {
    for (let y = 0; y < h; y += 24) for (let x = ((y / 24) % 2) * 16 - 16; x < w; x += 32) { const v = 28 + R() * 20; g.fillStyle = `rgb(${v | 0},${v - 3 | 0},${v + 3 | 0})`; g.fillRect(x, y, 30, 22); g.fillStyle = 'rgba(0,0,0,0.5)'; g.fillRect(x, y + 20, 30, 4); }
    noise(g, w, h, R, 1500, ['#000', '#2a3a20'], 0.3);
  }, 13);
  T.wood = tex(256, 256, (g, w, h, R) => {
    g.fillStyle = '#3a2416'; g.fillRect(0, 0, w, h);
    for (let y = 0; y < h; y += 2) { g.fillStyle = `rgba(${R() < 0.5 ? '20,10,4' : '90,60,35'},${R() * 0.35})`; g.fillRect(0, y + Math.sin(y * 0.1) * 2, w, 1); }
    for (let i = 0; i < 3; i++) { g.strokeStyle = 'rgba(15,8,3,0.5)'; g.beginPath(); g.ellipse(R() * w, R() * h, 10, 4, 0, 0, 7); g.stroke(); }
  }, 14);
  T.cloth = tex(128, 128, (g, w, h, R) => {
    g.fillStyle = '#4a4458'; g.fillRect(0, 0, w, h);
    for (let y = 0; y < h; y += 32) for (let x = 0; x < w; x += 32) { g.fillStyle = (x + y) % 64 ? '#5a3a3a' : '#3a4a5a'; g.fillRect(x + 2, y + 2, 28, 28); g.strokeStyle = 'rgba(255,255,255,0.15)'; g.setLineDash([2, 2]); g.strokeRect(x + 4, y + 4, 24, 24); }
    noise(g, w, h, R, 800, ['#000'], 0.35);
    stain(g, 70, 60, 30, 'rgba(60,10,10,1)', 0.4);
  }, 15);
  T.metal = tex(128, 128, (g, w, h, R) => { g.fillStyle = '#4a4c4e'; g.fillRect(0, 0, w, h); noise(g, w, h, R, 1500, ['#6a3a1a', '#2a2a2a', '#7a7a7a'], 0.5, 3); stain(g, 40, 90, 40, 'rgba(110,50,15,1)', 0.5); }, 16);
  T.capStripe = tex(32, 64, (g, w, h) => { for (let y = 0; y < h; y += 8) { g.fillStyle = (y / 8) % 2 ? '#e0d8c8' : '#7a1818'; g.fillRect(0, y, w, 8); } }, 17);
  T.web = tex(128, 128, (g, w, h, R) => {
    g.clearRect(0, 0, w, h); g.strokeStyle = 'rgba(220,220,220,0.55)'; g.lineWidth = 1;
    for (let a = 0; a < 9; a++) { const an = a / 8 * Math.PI / 2; g.beginPath(); g.moveTo(0, 0); g.lineTo(Math.cos(an) * 128, Math.sin(an) * 128); g.stroke(); }
    for (let r = 12; r < 128; r += 14 + R() * 6) { g.beginPath(); for (let a = 0; a <= 8; a++) { const an = a / 8 * Math.PI / 2; const rr = r + R() * 4; a ? g.lineTo(Math.cos(an) * rr, Math.sin(an) * rr) : g.moveTo(Math.cos(an) * rr, Math.sin(an) * rr); } g.stroke(); }
  }, 18);
  T.blood = tex(128, 128, (g, w, h, R) => {
    g.clearRect(0, 0, w, h);
    for (let i = 0; i < 14; i++) { g.fillStyle = `rgba(${70 + R() * 40 | 0},0,0,${0.5 + R() * 0.4})`; g.beginPath(); g.arc(64 + (R() - 0.5) * 70, 64 + (R() - 0.5) * 70, 4 + R() * 22, 0, 7); g.fill(); }
  }, 19);
  T.writing = tex(256, 128, (g, w, h) => {
    g.clearRect(0, 0, w, h); g.fillStyle = 'rgba(110,10,10,0.85)'; g.font = 'bold 30px Georgia'; g.textAlign = 'center';
    g.fillText('НЕ ВЕРЬ', 128, 52); g.fillText('КУКЛЕ', 128, 92);
    for (let i = 0; i < 12; i++) g.fillRect(40 + i * 15, 56 + (i % 3) * 30, 2, 10 + (i * 7) % 30);
  }, 20);
  T.paintings = [0, 1, 2, 3, 4, 5].map(i => tex(128, 160, (g, w, h, R) => {
    const bg = ['#26301f', '#3a2a22', '#1f2433', '#33301f', '#2a1a1a', '#1a2a2a'][i];
    g.fillStyle = '#4a3014'; g.fillRect(0, 0, w, h); g.fillStyle = '#7a5a20'; g.fillRect(4, 4, w - 8, h - 8);
    g.fillStyle = bg; g.fillRect(12, 12, w - 24, h - 24);
    const gr = g.createRadialGradient(64, 70, 5, 64, 80, 70); gr.addColorStop(0, 'rgba(255,220,160,0.15)'); gr.addColorStop(1, 'rgba(0,0,0,0.4)'); g.fillStyle = gr; g.fillRect(12, 12, w - 24, h - 24);
    // портрет
    g.fillStyle = '#0c0807'; g.beginPath(); g.ellipse(64, 135, 40, 30, 0, Math.PI, 0); g.fill();
    g.fillStyle = ['#b8a890', '#a89878', '#c0b0a0', '#988870', '#d0c0b0', '#a0a0a0'][i]; g.beginPath(); g.ellipse(64, 70, 22, 28, 0, 0, 7); g.fill();
    g.fillStyle = '#2a2018'; g.beginPath(); g.ellipse(64, 50, 25, 14, 0, Math.PI, 0); g.fill();
    if (i === 2 || i === 4) { g.fillStyle = '#000'; g.fillRect(48, 64, 32, 6); } // глаза выцарапаны
    else { g.fillStyle = '#1a1010'; g.fillRect(54, 66, 6, 3); g.fillRect(68, 66, 6, 3); }
    g.fillStyle = '#3a1010'; g.fillRect(57, 84, 14, 2);
    noise(g, w, h, R, 1500, ['#000', '#5a4a30'], 0.25);
    if (i === 4) { g.fillStyle = 'rgba(120,0,0,0.6)'; g.fillRect(56, 70, 2, 30); g.fillRect(72, 70, 2, 24); }
  }, 30 + i));
  const memo = (fn) => { const cache = {}; return (a, b) => cache[a] || (cache[a] = fn(a, b)); };
  T.skin = memo((base, seed) => tex(128, 128, (g, w, h, R) => {
    g.fillStyle = base; g.fillRect(0, 0, w, h);
    noise(g, w, h, R, 2500, ['#000', '#fff', '#5a2a2a'], 0.06, 3);
    for (let i = 0; i < 30; i++) { g.strokeStyle = 'rgba(0,0,0,0.12)'; g.beginPath(); const x = R() * w, y = R() * h; g.moveTo(x, y); g.quadraticCurveTo(x + 8, y + R() * 4, x + 16, y); g.stroke(); }
    for (let i = 0; i < 8; i++) stain(g, R() * w, R() * h, 4 + R() * 8, 'rgba(90,60,40,1)', 0.3);
  }, seed));
  T.dress = memo((base, seed) => tex(128, 128, (g, w, h, R) => {
    g.fillStyle = base; g.fillRect(0, 0, w, h);
    for (let x = 0; x < w; x += 8) { g.fillStyle = 'rgba(0,0,0,0.15)'; g.fillRect(x, 0, 3, h); }
    for (let y = 0; y < h; y += 16) for (let x = (y / 16 % 2) * 8; x < w; x += 16) { g.fillStyle = 'rgba(255,255,255,0.07)'; g.beginPath(); g.arc(x, y, 2, 0, 7); g.fill(); }
    noise(g, w, h, R, 1500, ['#000'], 0.2);
    stain(g, 90, 100, 25, 'rgba(50,10,5,1)', 0.45);
  }, seed));
  T.porcelain = tex(128, 128, (g, w, h, R) => {
    g.fillStyle = '#ece4da'; g.fillRect(0, 0, w, h); noise(g, w, h, R, 800, ['#c8bfb4'], 0.4);
    for (let i = 0; i < 3; i++) crack(g, R, 40 + R() * 50, R() * 40, 9, 'rgba(60,50,45,0.8)');
  }, 40);
  T.flesh = tex(128, 128, (g, w, h, R) => {
    g.fillStyle = '#2a1230'; g.fillRect(0, 0, w, h);
    for (let i = 0; i < 40; i++) stain(g, R() * w, R() * h, 6 + R() * 16, R() < 0.5 ? 'rgba(120,40,90,1)' : 'rgba(10,0,10,1)', 0.5);
    for (let i = 0; i < 25; i++) { g.strokeStyle = 'rgba(160,40,60,0.5)'; g.beginPath(); let x = R() * w, y = R() * h; g.moveTo(x, y); for (let k = 0; k < 5; k++) { x += R() * 16 - 8; y += R() * 16 - 8; g.lineTo(x, y); } g.stroke(); }
  }, 41);
  return T;
}

// ---------- сборка геометрии ----------
class Geo {
  constructor() { this.b = {}; }
  bucket(k) { return this.b[k] || (this.b[k] = { p: [], n: [], u: [] }); }
  quad(k, a, b, c, d, uw = 1, uh = 1, u0 = 0, v0 = 0) {
    const B = this.bucket(k);
    const ux = b[0] - a[0], uy = b[1] - a[1], uz = b[2] - a[2];
    const vx = c[0] - a[0], vy = c[1] - a[1], vz = c[2] - a[2];
    let nx = uy * vz - uz * vy, ny = uz * vx - ux * vz, nz = ux * vy - uy * vx;
    const l = Math.hypot(nx, ny, nz) || 1; nx /= l; ny /= l; nz /= l;
    const P = [a, b, c, a, c, d];
    const U = [[u0, v0], [u0 + uw, v0], [u0 + uw, v0 + uh], [u0, v0], [u0 + uw, v0 + uh], [u0, v0 + uh]];
    for (let i = 0; i < 6; i++) { B.p.push(...P[i]); B.n.push(nx, ny, nz); B.u.push(...U[i]); }
  }
  meshes(mats) {
    const out = [];
    for (const k in this.b) {
      const B = this.b[k];
      const g = new THREE.BufferGeometry();
      g.setAttribute('position', new THREE.Float32BufferAttribute(B.p, 3));
      g.setAttribute('normal', new THREE.Float32BufferAttribute(B.n, 3));
      g.setAttribute('uv', new THREE.Float32BufferAttribute(B.u, 2));
      g.computeBoundingSphere();
      const m = new THREE.Mesh(g, mats[k]); m.name = k; out.push(m);
    }
    return out;
  }
}

const YARD = new Set(['g', 'f', 'G', 'r', 'R', 'Y']);
const L = (o) => new THREE.MeshLambertMaterial(o);
const bumped = (map, s = 0.04, extra = {}) => L({ map, bumpMap: map, bumpScale: s, ...extra });

export function buildWorld(scene, maps, T) {
  const mats = {
    wall1: bumped(T.wall1, 0.6), wall2: bumped(T.wall2, 0.6), brick: bumped(T.brick, 1.5),
    siding: bumped(T.siding, 1), window: L({ map: T.window, emissiveMap: T.window, emissive: 0x8a5a20, emissiveIntensity: 0.35 }),
    planks: bumped(T.planks, 0.8), tile: bumped(T.tile, 0.6), stone: bumped(T.stone, 1.4), grass: bumped(T.grass, 1),
    ceil: bumped(T.ceil, 0.5), cceil: L({ map: T.stone, color: 0x6a6a6a }),
    roof: L({ map: T.roof, side: THREE.DoubleSide }),
  };
  const geo = new Geo();
  const waterGeo = new Geo();
  const cell = (f, x, z) => (x < 0 || z < 0 || x >= W || z >= H) ? null : maps[f][z][x];
  const DIRS = [[1, 0], [-1, 0], [0, 1], [0, -1]];
  const inTile = (f, x, z) => TILE_ROOMS.some(([tf, x0, z0, x1, z1]) => tf === f && x >= x0 && x <= x1 && z >= z0 && z <= z1);

  for (let f = 0; f < 3; f++) {
    const y0 = FLOOR_Y[f];
    for (let z = 0; z < H; z++) for (let x = 0; x < W; x++) {
      const ch = maps[f][z][x];
      const x0 = x * CS, x1 = x0 + CS, z0 = z * CS, z1 = z0 + CS;
      if (ch === '#') {
        for (const [dx, dz] of DIRS) {
          const n = cell(f, x + dx, z + dz);
          if (n === null || n === '#') continue;
          let key;
          const outside = !insideHouse(x + dx, z + dz);
          if (f === 0) key = 'brick';
          else if (outside) key = ((x * 7 + z * 3 + f) % 3 === 0) ? 'window' : 'siding';
          else key = f === 1 ? 'wall1' : 'wall2';
          const ya = f === 0 ? y0 - 0.7 : y0, yb = y0 + 3;
          const rx = dz, rz = -dx;
          const cx = (x + 0.5) * CS + dx * CS / 2, cz = (z + 0.5) * CS + dz * CS / 2;
          const a = [cx - rx * CS / 2, ya, cz - rz * CS / 2], b = [cx + rx * CS / 2, ya, cz + rz * CS / 2];
          if (f === 0) geo.quad(key, a, b, [b[0], yb, b[2]], [a[0], yb, a[2]], 1, (yb - ya) / CS);
          else geo.quad(key, a, b, [b[0], yb, b[2]], [a[0], yb, a[2]], 1, 1);
        }
        continue;
      }
      if (ch === ' ') continue;
      if (ch === 'w') {
        const yw = y0 - 0.45;
        waterGeo.quad('water', [x0, yw, z1], [x1, yw, z1], [x1, yw, z0], [x0, yw, z0]);
        if (z === H - 1) for (let k = 1; k < 5; k++) waterGeo.quad('water', [x0, yw, z1 + k * CS], [x1, yw, z1 + k * CS], [x1, yw, z1 + (k - 1) * CS], [x0, yw, z1 + (k - 1) * CS]);
      } else if (ch === 'S') {
        const r = rampAt(x, z);
        if (r.low === f) {
          // настоящие ступени
          const steps = 6, key = f === 0 ? 'stone' : 'planks';
          for (let i = 0; i < steps; i++) {
            const t0 = i / steps, t1 = (i + 1) / steps;
            if (r.axis === 'x') {
              const sx0 = x0 + t0 * CS, sx1 = x0 + t1 * CS, sy = rampY(r, sx1, z0);
              const prev = rampY(r, sx0, z0);
              geo.quad(key, [sx0, sy, z1], [sx1, sy, z1], [sx1, sy, z0], [sx0, sy, z0], 0.33, 1);
              geo.quad(key, [sx0, prev, z0], [sx0, prev, z1], [sx0, sy, z1], [sx0, sy, z0], 1, 0.1);
            } else {
              const sz0 = z0 + t0 * CS, sz1 = z0 + t1 * CS, sy = rampY(r, x0, sz0);
              const prev = rampY(r, x0, sz1);
              geo.quad(key, [x0, sy, sz1], [x1, sy, sz1], [x1, sy, sz0], [x0, sy, sz0], 1, 0.33);
              geo.quad(key, [x0, prev, sz1], [x1, prev, sz1], [x1, sy, sz1], [x0, sy, sz1], 1, 0.1);
            }
          }
        }
      } else {
        const yard = f === 1 && YARD.has(ch);
        const key = f === 0 ? 'stone' : yard ? 'grass' : inTile(f, x, z) ? 'tile' : 'planks';
        geo.quad(key, [x0, y0, z1], [x1, y0, z1], [x1, y0, z0], [x0, y0, z0]);
      }
      // потолок
      const inHouse = f === 0 || insideHouse(x, z);
      if (inHouse || ch === 'w') {
        const above = f < 2 ? maps[f + 1][z][x] : null;
        const r = ch === 'S' ? rampAt(x, z) : null;
        const skip = above === 'S' || (r && r.low === f);
        if (!skip) {
          const yc = y0 + 3 - 0.01;
          geo.quad(f === 0 ? 'cceil' : 'ceil', [x0, yc, z0], [x1, yc, z0], [x1, yc, z1], [x0, yc, z1]);
        }
      }
    }
  }
  // крыша
  const rx0 = 2 * CS - 0.6, rx1 = 18 * CS + 0.6, rz0 = 3 * CS - 0.6, rz1 = 15 * CS + 0.6, ry = 6, rtop = 9.5, rzm = (3 + 15) / 2 * CS;
  geo.quad('roof', [rx0, ry, rz0], [rx1, ry, rz0], [rx1, rtop, rzm], [rx0, rtop, rzm], 8, 3);
  geo.quad('roof', [rx1, ry, rz1], [rx0, ry, rz1], [rx0, rtop, rzm], [rx1, rtop, rzm], 8, 3);
  geo.quad('siding', [rx0 + 0.6, ry, rz1 - 0.6], [rx0 + 0.6, ry, rz0 + 0.6], [rx0 + 0.6, rtop, rzm], [rx0 + 0.6, rtop, rzm], 6, 2);
  geo.quad('siding', [rx1 - 0.6, ry, rz0 + 0.6], [rx1 - 0.6, ry, rz1 - 0.6], [rx1 - 0.6, rtop, rzm], [rx1 - 0.6, rtop, rzm], 6, 2);

  const group = new THREE.Group();
  for (const m of geo.meshes(mats)) group.add(m);
  const waterMat = L({ map: T.water, emissive: 0x041012, transparent: true, opacity: 0.9 });
  const water = waterGeo.meshes({ water: waterMat })[0];
  group.add(water);
  scene.add(group);
  return { group, water, mats };
}

// ---------- мебель, декор, коллайдеры ----------
export function box(w, h, d, mat, x = 0, y = 0, z = 0) {
  const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat); m.position.set(x, y, z); return m;
}
function cyl(rt, rb, h, mat, x = 0, y = 0, z = 0, seg = 10) { const m = new THREE.Mesh(new THREE.CylinderGeometry(rt, rb, h, seg), mat); m.position.set(x, y, z); return m; }

// локальный прямоугольник мебели → AABB в мире
function toAABB(g, lx0, lx1, lz0, lz1) {
  const r = g.rotation.y, c = Math.cos(r), s = Math.sin(r);
  const xs = [], zs = [];
  for (const [lx, lz] of [[lx0, lz0], [lx1, lz0], [lx0, lz1], [lx1, lz1]]) { xs.push(g.position.x + lx * c + lz * s); zs.push(g.position.z - lx * s + lz * c); }
  return { x0: Math.min(...xs), x1: Math.max(...xs), z0: Math.min(...zs), z1: Math.max(...zs) };
}
export function localToWorld(g, lx, ly, lz) {
  const r = g.rotation.y, c = Math.cos(r), s = Math.sin(r);
  return new THREE.Vector3(g.position.x + lx * c + lz * s, g.position.y + ly, g.position.z - lx * s + lz * c);
}

export function buildFurniture(scene, maps, T) {
  const wood = L({ map: T.wood }), woodL = L({ map: T.wood, color: 0xb08a68 });
  const dark = L({ color: 0x1a120c }), cloth = L({ map: T.cloth }), linen = L({ color: 0x8e887c });
  const white = L({ color: 0xb8b2a6 }), metal = L({ map: T.metal }), brass = L({ color: 0x9a7a30, emissive: 0x1a1000 });
  const fenceM = L({ map: T.fence }), leaf = L({ color: 0x101c0c, flatShading: true }), bark = L({ map: T.wood, color: 0x5a4a3a });
  const glassM = L({ color: 0x2a3a3a, transparent: true, opacity: 0.6 });
  const webM = new THREE.MeshBasicMaterial({ map: T.web, transparent: true, depthWrite: false, side: THREE.DoubleSide, fog: true });
  const bloodM = L({ map: T.blood, transparent: true, depthWrite: false, polygonOffset: true, polygonOffsetFactor: -2 });
  const hides = [], colliders = [], surfaces = [];
  const root = new THREE.Group(); scene.add(root);
  const isOpen = (c) => c && !'#WBTfY H'.includes(c);
  const addCol = (f, g, lx0, lx1, lz0, lz1, h) => { const a = toAABB(g, lx0, lx1, lz0, lz1); colliders.push({ f, ...a, y0: FLOOR_Y[f], y1: FLOOR_Y[f] + h }); return a; };
  const addSurf = (f, g, lx0, lx1, lz0, lz1, top) => { const a = toAABB(g, lx0, lx1, lz0, lz1); surfaces.push({ f, ...a, top: FLOOR_Y[f] + top }); };
  // направление «к свободному месту, спиной к стене»
  const faceOf = (f, x, z) => {
    const nb = (dx, dz) => (maps[f][z + dz] || [])[x + dx];
    for (const d of [[0, 1], [0, -1], [1, 0], [-1, 0]]) if (isOpen(nb(d[0], d[1])) && nb(-d[0], -d[1]) === '#') return d;
    for (const d of [[0, 1], [0, -1], [1, 0], [-1, 0]]) if (isOpen(nb(d[0], d[1]))) return d;
    return [0, 1];
  };
  const placeG = (f, x, z, face) => { const g = new THREE.Group(); g.position.set((x + 0.5) * CS, FLOOR_Y[f], (z + 0.5) * CS); g.rotation.y = Math.atan2(face[0], face[1]); return g; };
  let chest = null;

  for (let f = 0; f < 3; f++) for (let z = 0; z < H; z++) for (let x = 0; x < W; x++) {
    const ch = maps[f][z][x];
    const cx = (x + 0.5) * CS, cz = (z + 0.5) * CS, y = FLOOR_Y[f];
    const nb = (dx, dz) => (maps[f][z + dz] || [])[x + dx];
    if (ch === 'T') {
      const type = FURN_TYPE[f + ',' + x + ',' + z] || 'table';
      const face = faceOf(f, x, z);
      const g = placeG(f, x, z, face);
      if (type === 'table') {
        g.rotation.y = 0;
        g.add(box(1.7, 0.08, 1.15, wood, 0, 0.8, 0));
        g.add(box(1.55, 0.12, 1.0, dark, 0, 0.7, 0));
        for (const [lx, lz] of [[-0.72, -0.45], [0.72, -0.45], [-0.72, 0.45], [0.72, 0.45]]) g.add(cyl(0.045, 0.035, 0.76, dark, lx, 0.38, lz, 6));
        g.add(box(1.0, 0.01, 0.6, L({ color: 0x8a7a68 }), 0, 0.845, 0)); // скатерть
        // стулья
        for (const s of [-1, 1]) { const ch2 = new THREE.Group(); ch2.position.set(0.3 * s, 0, 0.9 * s); ch2.rotation.y = s > 0 ? Math.PI : 0; ch2.add(box(0.45, 0.05, 0.45, wood, 0, 0.46, 0)); ch2.add(box(0.45, 0.6, 0.05, wood, 0, 0.78, -0.2)); for (const [lx, lz] of [[-0.19, -0.19], [0.19, -0.19], [-0.19, 0.19], [0.19, 0.19]]) ch2.add(box(0.04, 0.46, 0.04, dark, lx, 0.23, lz)); ch2.rotation.z = s > 0 ? 0 : 0.0; g.add(ch2); }
        addCol(f, g, -0.85, 0.85, -0.58, 0.58, 0.84); addSurf(f, g, -0.8, 0.8, -0.52, 0.52, 0.845);
      } else if (type === 'stove') {
        g.add(box(1.8, 0.9, 0.7, white, 0, 0.45, -0.62)); g.add(box(1.85, 0.05, 0.75, dark, 0, 0.92, -0.62));
        for (const lx of [-0.5, 0.0, 0.5]) { g.add(box(0.36, 0.5, 0.02, L({ color: 0x8a847a }), lx, 0.45, -0.26)); g.add(box(0.1, 0.03, 0.03, brass, lx, 0.62, -0.25)); }
        for (const lx of [-0.55, -0.15]) g.add(cyl(0.12, 0.12, 0.02, dark, lx, 0.955, -0.62, 10));
        g.add(cyl(0.14, 0.12, 0.2, metal, 0.45, 1.05, -0.62));
        g.add(box(1.8, 0.6, 0.35, wood, 0, 1.9, -0.82)); // полка
        for (let i = 0; i < 5; i++) g.add(cyl(0.05, 0.05, 0.16, L({ color: [0x3a5a2a, 0x6a3a1a, 0x8a8a7a][i % 3] }), -0.7 + i * 0.35, 2.28, -0.82, 6));
        addCol(f, g, -0.92, 0.92, -1.0, -0.25, 0.95); addSurf(f, g, -0.85, 0.85, -0.92, -0.32, 0.95);
      } else if (type === 'desk') {
        g.add(box(1.4, 0.06, 0.7, wood, 0, 0.78, -0.6)); g.add(box(0.4, 0.75, 0.66, wood, -0.48, 0.38, -0.6)); g.add(box(0.06, 0.75, 0.66, wood, 0.66, 0.38, -0.6));
        g.add(box(0.3, 0.02, 0.2, white, 0.2, 0.82, -0.6)); g.add(cyl(0.03, 0.05, 0.15, brass, -0.4, 0.88, -0.75));
        addCol(f, g, -0.72, 0.72, -1.0, -0.22, 0.8); addSurf(f, g, -0.65, 0.65, -0.9, -0.3, 0.81);
      } else if (type === 'dresser') {
        g.add(box(1.3, 1.0, 0.55, wood, 0, 0.5, -0.7));
        for (let i = 0; i < 3; i++) { g.add(box(1.2, 0.26, 0.02, woodL, 0, 0.2 + i * 0.3, -0.42)); g.add(box(0.12, 0.03, 0.04, brass, 0, 0.22 + i * 0.3, -0.4)); }
        g.add(box(0.9, 0.9, 0.03, L({ color: 0x5a6a6a, emissive: 0x0a1010 }), 0, 1.55, -0.95)); // зеркало
        g.add(box(1.0, 1.0, 0.02, wood, 0, 1.55, -0.965));
        addCol(f, g, -0.67, 0.67, -1.0, -0.4, 1.0); addSurf(f, g, -0.6, 0.6, -0.92, -0.5, 1.0);
      } else if (type === 'tub') {
        const tub = L({ color: 0xc8c2b8 });
        g.add(box(1.8, 0.6, 0.12, tub, 0, 0.3, -0.25)); g.add(box(1.8, 0.6, 0.12, tub, 0, 0.3, -0.95)); g.add(box(0.12, 0.6, 0.8, tub, -0.85, 0.3, -0.6)); g.add(box(0.12, 0.6, 0.8, tub, 0.85, 0.3, -0.6));
        g.add(box(1.6, 0.08, 0.6, tub, 0, 0.12, -0.6)); g.add(box(1.5, 0.02, 0.5, L({ color: 0x2a3a2a, transparent: true, opacity: 0.85 }), 0, 0.4, -0.6));
        g.add(cyl(0.03, 0.03, 0.3, metal, 0.7, 0.8, -0.95));
        addCol(f, g, -0.9, 0.9, -1.0, -0.2, 0.6); addSurf(f, g, -0.7, 0.7, -0.85, -0.35, 0.16);
      } else if (type === 'bench') {
        g.add(box(1.8, 0.08, 0.8, wood, 0, 0.9, -0.58)); for (const lx of [-0.8, 0.8]) for (const lz of [-0.9, -0.25]) g.add(box(0.08, 0.9, 0.08, dark, lx, 0.45, lz));
        g.add(box(1.7, 0.04, 0.7, wood, 0, 0.3, -0.58)); g.add(box(0.3, 0.2, 0.2, metal, 0.6, 1.04, -0.75)); g.add(box(1.8, 0.8, 0.04, L({ color: 0x3a2a1a }), 0, 1.6, -0.98));
        addCol(f, g, -0.92, 0.92, -1.0, -0.16, 0.94); addSurf(f, g, -0.85, 0.85, -0.92, -0.24, 0.94);
      } else if (type === 'chest') {
        g.add(box(1.0, 0.45, 0.6, wood, 0, 0.225, -0.6)); g.add(box(1.02, 0.05, 0.62, metal, 0, 0.1, -0.6)); g.add(box(1.02, 0.05, 0.62, metal, 0, 0.35, -0.6));
        const lid = new THREE.Group(); lid.position.set(0, 0.45, -0.9); lid.userData.dyn = true; g.add(lid);
        lid.add(box(1.0, 0.12, 0.6, wood, 0, 0.06, 0.3)); lid.add(box(1.02, 0.03, 0.62, metal, 0, 0.1, 0.3));
        const lock = box(0.12, 0.14, 0.04, brass, 0, 0.38, -0.29); lock.userData.dyn = true; g.add(lock);
        addCol(f, g, -0.52, 0.52, -0.92, -0.28, 0.6);
        chest = { f, group: g, lid, lock, pos: localToWorld(g, 0, 0.5, -0.4), inside: localToWorld(g, 0, 0.25, -0.6), open: false };
      }
      root.add(g);
    } else if (ch === 'W' || ch === 'B') {
      const face = faceOf(f, x, z);
      const g = placeG(f, x, z, face);
      let doors = null;
      if (ch === 'W') {
        // полый шкаф: стенки, полки и две створки со щелью
        const m = L({ map: T.wood, side: THREE.DoubleSide });
        g.add(box(1.5, 2.3, 0.04, m, 0, 1.15, -0.98));
        g.add(box(0.04, 2.3, 0.8, m, -0.73, 1.15, -0.6)); g.add(box(0.04, 2.3, 0.8, m, 0.73, 1.15, -0.6));
        g.add(box(1.5, 0.04, 0.8, m, 0, 2.3, -0.6)); g.add(box(1.5, 0.04, 0.8, m, 0, 0.04, -0.6));
        g.add(box(1.62, 0.12, 0.9, dark, 0, 2.38, -0.58)); g.add(box(1.55, 0.1, 0.85, dark, 0, 0.05, -0.58));
        g.add(cyl(0.015, 0.015, 1.4, metal, 0, 2.0, -0.6).rotateZ(Math.PI / 2));
        for (const lx of [-0.45, -0.25, 0.3]) { const hg = box(0.4, 0.8, 0.03, L({ color: [0x3a3030, 0x2a3040, 0x40302a][(lx * 10 | 0) & 1 ? 1 : 0] }), lx, 1.55, -0.6); hg.rotation.y = 1.2; g.add(hg); }
        doors = [];
        for (const s of [-1, 1]) {
          const piv = new THREE.Group(); piv.position.set(0.74 * s, 1.15, -0.2); g.add(piv);
          const leaf = new THREE.Group(); leaf.position.x = -0.355 * s; piv.add(leaf);
          leaf.add(box(0.7, 2.2, 0.04, m));
          leaf.add(box(0.5, 0.7, 0.02, woodL, 0, 0.5, 0.025)); leaf.add(box(0.5, 0.7, 0.02, woodL, 0, -0.45, 0.025));
          leaf.add(box(0.03, 0.14, 0.04, brass, -0.3 * s, 0, 0.04));
          piv.userData.s = s; piv.userData.dyn = true; doors.push(piv);
        }
        addCol(f, g, -0.78, 0.78, -1.0, -0.18, 2.4);
      } else {
        g.add(box(1.4, 0.1, 1.95, dark, 0, 0.42, 0));
        for (const [lx, lz] of [[-0.66, -0.93], [0.66, -0.93], [-0.66, 0.93], [0.66, 0.93]]) g.add(box(0.08, 0.42, 0.08, dark, lx, 0.21, lz));
        g.add(box(1.32, 0.18, 1.85, linen, 0, 0.56, 0));
        g.add(box(0.8, 0.14, 0.38, white, 0, 0.72, -0.7));
        const blanket = box(1.44, 0.06, 1.3, cloth, 0, 0.68, 0.3); g.add(blanket);
        g.add(box(0.03, 0.4, 1.3, cloth, -0.72, 0.48, 0.3)); g.add(box(0.03, 0.4, 1.3, cloth, 0.72, 0.48, 0.3));
        g.add(box(1.4, 1.1, 0.08, wood, 0, 0.65, -1.0)); g.add(box(1.4, 0.6, 0.08, wood, 0, 0.4, 0.98));
        for (let i = -2; i <= 2; i++) g.add(cyl(0.025, 0.025, 0.9, dark, i * 0.25, 0.9, -1.0, 6));
        addCol(f, g, -0.72, 0.72, -1.0, 1.0, 0.75); addSurf(f, g, -0.6, 0.6, -0.4, 0.8, 0.72);
      }
      root.add(g);
      hides.push({ f, x, z, type: ch === 'W' ? 'wardrobe' : 'bed', face, pos: new THREE.Vector3(cx, y, cz), group: g, doors, open: 0 });
    } else if (ch === 'f' && f === 1) {
      const isF = (c) => c === 'f' || c === 'G';
      const alongX = isF(nb(1, 0)) || isF(nb(-1, 0));
      const alongZ = isF(nb(0, 1)) || isF(nb(0, -1));
      const mk = (w, d) => { const g = new THREE.Group(); g.position.set(cx, y, cz); for (let i = 0; i < 9; i++) { const t = -0.9 + i * 0.225; const h = 1.6 + ((x * 7 + z * 3 + i) % 4) * 0.1; const p = box(w ? 0.18 : 0.06, h, w ? 0.06 : 0.18, fenceM, w ? t : 0, h / 2, w ? 0 : t); p.rotation.z = ((i * 13 + x) % 5 - 2) * 0.02; g.add(p); } g.add(box(w ? 2 : 0.08, 0.1, w ? 0.08 : 2, dark, 0, 0.5, w ? -0.06 : 0).translateX(w ? 0 : -0.06)); g.add(box(w ? 2 : 0.08, 0.1, w ? 0.08 : 2, dark, 0, 1.3, w ? -0.06 : 0).translateX(w ? 0 : -0.06)); return g; };
      if (alongX) root.add(mk(true)); if (alongZ) root.add(mk(false));
    } else if (ch === 'Y') {
      const g = new THREE.Group(); g.position.set(cx, y, cz);
      const trunk = cyl(0.18, 0.32, 4.2, bark, 0, 2.1, 0, 7); trunk.rotation.z = 0.04; g.add(trunk);
      const branch = (len, ry, rz, yy) => { const b = cyl(0.04, 0.09, len, bark, 0, 0, 0, 5); const p = new THREE.Group(); p.position.y = yy; p.rotation.set(0, ry, rz); b.position.y = len / 2; p.add(b); g.add(p); };
      for (let i = 0; i < 7; i++) branch(1.2 + (i % 3) * 0.5, i * 0.9 + x, 0.7 + (i % 2) * 0.3, 2.2 + i * 0.35);
      for (let i = 0; i < 4; i++) { const c = new THREE.Mesh(new THREE.IcosahedronGeometry(1.0 + (i % 2) * 0.3, 0), leaf); c.position.set(Math.sin(i * 2 + x) * 0.8, 4.2 + i * 0.5, Math.cos(i * 2 + z) * 0.8); c.scale.y = 0.7; g.add(c); }
      root.add(g);
      colliders.push({ f, x0: cx - 0.35, x1: cx + 0.35, z0: cz - 0.35, z1: cz + 0.35, y0: y, y1: y + 5 });
    } else if (ch === 'r' && f === 1) {
      root.add(box(0.08, 0.12, CS, metal, cx - 0.5, y + 0.06, cz)); root.add(box(0.08, 0.12, CS, metal, cx + 0.5, y + 0.06, cz));
      for (const o of [-0.6, 0, 0.6]) root.add(box(1.4, 0.07, 0.22, dark, cx, y + 0.035, cz + o));
    }
  }
  // перила балкона
  for (let x = 8; x <= 10; x++) root.add(box(CS, 0.1, 0.1, wood, (x + 0.5) * CS, 4.0, 2 * CS + 0.05));
  root.add(box(0.1, 0.1, CS, wood, 8 * CS + 0.05, 4.0, 2.5 * CS)); root.add(box(0.1, 0.1, CS, wood, 11 * CS - 0.05, 4.0, 2.5 * CS));
  for (let i = 0; i <= 12; i++) root.add(box(0.05, 1.0, 0.05, dark, 8 * CS + i * 0.5, 3.5, 2 * CS + 0.05));
  root.add(box(3 * CS, 0.2, CS, wood, 9.5 * CS, 2.9, 2.5 * CS));
  for (const px of [8.1, 10.9]) root.add(cyl(0.1, 0.1, 2.9, wood, px * CS, 1.45, 2.1 * CS, 6));
  // крыльцо
  root.add(box(3.2, 0.15, 1.2, wood, 9.5 * CS, 0.07, 3 * CS - 0.6));
  // кресло сторожа
  const chair = new THREE.Group(); chair.position.set(5.5 * CS, 0, 12.5 * CS);
  chair.add(box(0.85, 0.15, 0.8, cloth, 0, 0.48, 0)); chair.add(box(0.85, 1.1, 0.14, cloth, 0, 1.0, 0.38));
  chair.add(box(0.14, 0.32, 0.8, wood, -0.43, 0.68, 0)); chair.add(box(0.14, 0.32, 0.8, wood, 0.43, 0.68, 0));
  for (const [lx, lz] of [[-0.38, -0.33], [0.38, -0.33], [-0.38, 0.33], [0.38, 0.33]]) chair.add(box(0.06, 0.4, 0.06, dark, lx, 0.2, lz));
  root.add(chair);
  colliders.push({ f: 1, x0: 5.5 * CS - 0.45, x1: 5.5 * CS + 0.45, z0: 12.5 * CS - 0.4, z1: 12.5 * CS + 0.45, y0: 0, y1: 0.6 });
  // картины
  const pics = [[1, 3, 8, 'n'], [1, 12, 9, 's'], [2, 8, 9, 's'], [2, 16, 5, 'e'], [1, 10, 4, 'n'], [2, 4, 12, 'w'], [1, 13, 4, 'n'], [2, 13, 8, 'n']];
  pics.forEach(([f, x, z, side], i) => {
    const m = new THREE.Mesh(new THREE.PlaneGeometry(0.8, 1.0), L({ map: T.paintings[i % 6] }));
    const y = FLOOR_Y[f] + 1.75; let px = (x + 0.5) * CS, pz = (z + 0.5) * CS;
    if (side === 'n') { pz = z * CS + 0.03; } else if (side === 's') { pz = (z + 1) * CS - 0.03; m.rotation.y = Math.PI; }
    else if (side === 'e') { px = (x + 1) * CS - 0.03; m.rotation.y = -Math.PI / 2; } else { px = x * CS + 0.03; m.rotation.y = Math.PI / 2; }
    m.position.set(px, y, pz); m.rotation.z = ((i * 7) % 5 - 2) * 0.03; root.add(m);
  });
  // ковры
  const rug = L({ map: T.cloth, color: 0x9a4a4a });
  [[1, 9, 5], [1, 14, 5.2], [2, 4, 5], [2, 9, 8.5], [1, 6, 8.5]].forEach(([f, x, z]) => { root.add(box(2.2, 0.015, 1.5, rug, (x + 0.5) * CS, FLOOR_Y[f] + 0.008, (z + 0.5) * CS)); });
  // книжные полки вдоль стен коридоров (тонкие, с коллайдером)
  const books = [0x5a1a1a, 0x1a3a1a, 0x2a2a4a, 0x5a4a1a, 0x3a1a3a];
  const shelf = (f, x, z, side) => {
    const g = new THREE.Group(); g.position.set((x + 0.5) * CS, FLOOR_Y[f], (z + 0.5) * CS);
    g.rotation.y = { n: 0, s: Math.PI, w: Math.PI / 2, e: -Math.PI / 2 }[side];
    g.add(box(1.4, 2.0, 0.04, wood, 0, 1.0, -0.98)); g.add(box(0.05, 2.0, 0.38, wood, -0.68, 1.0, -0.8)); g.add(box(0.05, 2.0, 0.38, wood, 0.68, 1.0, -0.8));
    for (let k = 0; k < 4; k++) {
      g.add(box(1.36, 0.04, 0.38, wood, 0, 0.1 + k * 0.5, -0.8));
      let bx = -0.62; while (bx < 0.6) { const bw = 0.05 + ((bx * 100 | 0) % 4) * 0.015; const bh = 0.3 + ((bx * 77 | 0) % 5) * 0.03; g.add(box(bw, bh, 0.25, L({ color: books[(bx * 50 | 0) % 5 & 7] || 0x3a2a1a }), bx + bw / 2, 0.12 + k * 0.5 + bh / 2, -0.82)); bx += bw + 0.01; }
    }
    root.add(g); const a = toAABB(g, -0.72, 0.72, -1.0, -0.6); colliders.push({ f, ...a, y0: FLOOR_Y[f], y1: FLOOR_Y[f] + 2 });
  };
  shelf(1, 11, 8, 'n'); shelf(2, 11, 8, 'n'); shelf(1, 4, 11, 'n');
  // часы-ходики
  const clock = (f, x, z) => { const g = new THREE.Group(); g.position.set((x + 0.5) * CS, FLOOR_Y[f], z * CS + 0.25); g.add(box(0.5, 2.0, 0.35, wood, 0, 1.0, 0)); g.add(cyl(0.18, 0.18, 0.03, white, 0, 1.6, 0.18).rotateX(Math.PI / 2)); g.add(box(0.02, 0.12, 0.01, dark, 0, 1.64, 0.2)); const pend = new THREE.Group(); pend.userData.dyn = true; pend.position.set(0, 1.25, 0.18); pend.add(box(0.02, 0.5, 0.01, brass, 0, -0.25, 0)); pend.add(cyl(0.07, 0.07, 0.02, brass, 0, -0.5, 0).rotateX(Math.PI / 2)); g.add(pend); g.userData.pend = pend; root.add(g); colliders.push({ f, x0: g.position.x - 0.28, x1: g.position.x + 0.28, z0: g.position.z - 0.2, z1: g.position.z + 0.2, y0: FLOOR_Y[f], y1: FLOOR_Y[f] + 2 }); return pend; };
  const pendulums = [clock(1, 15, 8)];
  // паутина в углах
  const web = (f, x, z, rot, hgt = 2.95) => { const m = new THREE.Mesh(new THREE.PlaneGeometry(1.0, 1.0), webM); m.position.set(x, FLOOR_Y[f] + hgt - 0.5, z); m.rotation.y = rot; root.add(m); };
  web(1, 3 * CS + 0.5, 4 * CS + 0.05, 0); web(1, 16 * CS + 0.5 + 1.0, 8 * CS + 0.05, 0); web(2, 3 * CS + 0.5, 11 * CS + 0.05, 0); web(0, 8 * CS + 0.5, 3 * CS + 0.05, 0); web(0, 11 * CS + 0.6, 6 * CS + 0.05, 0); web(0, 15 * CS + 0.5, 3 * CS + 0.05, 0); web(2, 16 * CS + 1.5, 4 * CS + 0.05, 0);
  // кровь и надпись
  const decal = (f, x, z, s, rot) => { const m = new THREE.Mesh(new THREE.PlaneGeometry(s, s), bloodM); m.rotation.set(-Math.PI / 2, 0, rot); m.position.set(x, FLOOR_Y[f] + 0.012, z); root.add(m); };
  decal(1, 9.6 * CS, 9 * CS, 1.2, 0.4); decal(2, 4.5 * CS, 12.6 * CS, 1.0, 1.3); decal(0, 11.5 * CS, 10 * CS, 1.4, 2); decal(0, 16.5 * CS, 4.5 * CS, 1.0, 0.2);
  const wr = new THREE.Mesh(new THREE.PlaneGeometry(1.6, 0.8), new THREE.MeshLambertMaterial({ map: T.writing, transparent: true, depthWrite: false })); wr.position.set(19 * CS - 0.03, -3 + 1.7, 4.5 * CS); wr.rotation.y = -Math.PI / 2; root.add(wr);
  // котёл и трубы в подвале
  const boiler = cyl(0.7, 0.7, 2.2, metal, 10.5 * CS, -3 + 1.1, 3.4 * CS, 12); root.add(boiler);
  colliders.push({ f: 0, x0: 10.5 * CS - 0.75, x1: 10.5 * CS + 0.75, z0: 3.4 * CS - 0.75, z1: 3.4 * CS + 0.75, y0: -3, y1: -0.8 });
  root.add(box(0.3, 0.3, 0.1, L({ color: 0xff5a10, emissive: 0xff3300 }), 10.5 * CS, -3 + 0.6, 3.4 * CS + 0.7));
  root.add(cyl(0.12, 0.12, 1.0, metal, 10.5 * CS, -0.5, 3.4 * CS, 8));
  for (let x = 5; x < 15; x++) root.add(cyl(0.07, 0.07, CS, metal, (x + 0.5) * CS, -0.35, 15.15 * CS, 6).rotateZ(Math.PI / 2));
  for (let z = 6; z < 15; z++) root.add(cyl(0.05, 0.05, CS, metal, 11.15 * CS, -0.3, (z + 0.5) * CS, 6).rotateX(Math.PI / 2));
  // ящики в подвале
  [[0, 5, 10, 0.2], [0, 8, 9.3, 0.6], [0, 13, 5.3, 1], [0, 4.5, 8.3, 0.1]].forEach(([f, x, z, r]) => {
    const b = box(0.8, 0.7, 0.8, L({ map: T.wood, color: 0x9a8a70 }), x * CS + 0.5, FLOOR_Y[f] + 0.35, z * CS + 0.5); b.rotation.y = r; root.add(b);
    colliders.push({ f, x0: b.position.x - 0.5, x1: b.position.x + 0.5, z0: b.position.z - 0.5, z1: b.position.z + 0.5, y0: FLOOR_Y[f], y1: FLOOR_Y[f] + 0.7 });
    surfaces.push({ f, x0: b.position.x - 0.35, x1: b.position.x + 0.35, z0: b.position.z - 0.35, z1: b.position.z + 0.35, top: FLOOR_Y[f] + 0.7 });
  });
  // доки у реки
  for (let z = 11; z <= 16; z++) root.add(box(0.95, 0.1, CS, wood, 3.55 * CS, -3 + 0.02, (z + 0.5) * CS));
  // тайный стеллаж
  const sec = new THREE.Group(); sec.position.set(14.5 * CS, -3, 4.5 * CS); sec.userData.dyn = true; root.add(sec);
  const sh = new THREE.Group(); sec.add(sh);
  sh.add(box(0.5, 2.9, 1.96, wood, 0, 1.45, 0));
  for (let k = 0; k < 5; k++) { sh.add(box(0.42, 0.04, 1.9, woodL, -0.06, 0.2 + k * 0.6, 0)); for (let j = 0; j < 4; j++) sh.add(cyl(0.06, 0.06, 0.2, L({ color: [0x3a5a2a, 0x5a3a1a, 0x2a2a3a, 0x6a6a5a][(j + k) % 4], transparent: true, opacity: 0.85 }), -0.12, 0.32 + k * 0.6, -0.7 + j * 0.45, 7)); }
  const socket = new THREE.Group(); socket.position.set(14 * CS - 0.03, -3 + 1.4, 3.6 * CS); socket.userData.dyn = true; root.add(socket);
  socket.add(box(0.06, 0.5, 0.5, metal)); socket.add(cyl(0.12, 0.12, 0.08, dark, 0.02, 0, 0, 10).rotateZ(Math.PI / 2));
  const secret = { shelf: sh, socket, pos: new THREE.Vector3(14 * CS - 0.1, -3 + 1.2, 4.5 * CS), open: false, t: 0 };
  // стойка с оружием в тайной комнате
  const rack = new THREE.Group(); rack.position.set(19 * CS - 0.1, -3, 3.5 * CS); rack.rotation.y = -Math.PI / 2; root.add(rack);
  rack.add(box(1.6, 1.4, 0.06, wood, 0, 1.3, 0)); rack.add(box(1.6, 0.06, 0.25, wood, 0, 0.9, 0.12)); rack.add(box(1.6, 0.06, 0.25, wood, 0, 1.5, 0.12));
  // свечи
  const candle = L({ color: 0xe8e0c8, emissive: 0x302010 }), flameM = new THREE.MeshBasicMaterial({ color: 0xffb040 });
  const flames = [];
  [[0, 16.2, 3.3], [0, 18.4, 5.6], [2, 3.4, 6.6]].forEach(([f, x, z]) => { root.add(cyl(0.03, 0.03, 0.2, candle, x * CS, FLOOR_Y[f] + (f === 2 ? 1.1 : 0.1), z * CS, 6)); const fl = new THREE.Mesh(new THREE.ConeGeometry(0.02, 0.06, 5), flameM); fl.position.set(x * CS, FLOOR_Y[f] + (f === 2 ? 1.24 : 0.24), z * CS); root.add(fl); flames.push(fl); });
  bakeStatic(root);
  return { root, hides, colliders, surfaces, secret, chest, pendulums, flames };
}

// Свет: ограниченное число ламп ради телефонов
export function buildLights(scene, quality) {
  const lamps = [];
  scene.add(new THREE.HemisphereLight(0x4a5070, 0x1c140e, 0.9));
  const moon = new THREE.DirectionalLight(0x8090c0, 0.5); moon.position.set(-20, 40, -30); scene.add(moon);
  const bulbMat = new THREE.MeshBasicMaterial({ color: 0xffd890 });
  const shadeM = new THREE.MeshLambertMaterial({ color: 0x6a3a1a, side: THREE.DoubleSide, emissive: 0x2a1000 });
  const add = (f, x, z, col, inten, dist, flicker, imp) => {
    if (quality === 'low' && !imp) return;
    const p = new THREE.PointLight(col, inten, dist, 1.6);
    p.position.set((x + 0.5) * CS, FLOOR_Y[f] + 2.45, (z + 0.5) * CS); scene.add(p);
    const b = new THREE.Mesh(new THREE.SphereGeometry(0.06, 8, 6), bulbMat); b.position.copy(p.position); scene.add(b);
    const sh = new THREE.Mesh(new THREE.ConeGeometry(0.28, 0.22, 10, 1, true), shadeM); sh.position.copy(p.position); sh.position.y += 0.08; scene.add(sh);
    const w = new THREE.Mesh(new THREE.CylinderGeometry(0.008, 0.008, 0.38), bulbMat); w.position.copy(p.position); w.position.y += 0.37; scene.add(w);
    lamps.push({ light: p, base: inten, flicker, bulb: b });
  };
  add(1, 4, 5, 0xffb060, 9, 11, false, true);
  add(1, 9, 8, 0xffc070, 8, 14, true, true);
  add(1, 14, 5, 0xffa050, 7, 10, true, false);
  add(2, 12, 8, 0xff9a60, 7, 14, false, true);
  add(2, 14, 5, 0xffb080, 6, 10, true, false);
  add(0, 10, 4, 0xff6a20, 10, 12, true, true);
  add(0, 5, 14, 0x60a0a0, 5, 10, false, false);
  add(0, 17, 4, 0xff8a30, 5, 7, true, false);
  return lamps;
}

// Склеиваем неподвижную мебель в несколько больших мешей — сотни мелких деталей
// превращаются в пару десятков вызовов отрисовки (важно для телефонов).
function matKey(m) { return [m.type, m.map ? m.map.uuid : '', m.color ? m.color.getHex() : '', m.emissive ? m.emissive.getHex() : '', m.transparent, m.opacity, m.side, m.depthWrite, m.polygonOffset].join('|'); }
export function bakeStatic(root) {
  root.updateMatrixWorld(true);
  const groups = new Map(), victims = [];
  const walk = (o) => {
    if (o.userData && o.userData.dyn) return;
    if (o.isMesh && !Array.isArray(o.material)) {
      let g = o.geometry.index ? o.geometry.toNonIndexed() : o.geometry.clone();
      for (const k of Object.keys(g.attributes)) if (!['position', 'normal', 'uv'].includes(k)) g.deleteAttribute(k);
      if (!g.attributes.uv) { g.setAttribute('uv', new THREE.Float32BufferAttribute(new Float32Array(g.attributes.position.count * 2), 2)); }
      if (!g.attributes.normal) g.computeVertexNormals();
      g.applyMatrix4(o.matrixWorld);
      const k = matKey(o.material);
      if (!groups.has(k)) groups.set(k, { mat: o.material, geos: [] });
      groups.get(k).geos.push(g); victims.push(o);
    }
    for (const c of o.children) walk(c);
  };
  for (const c of root.children) walk(c);
  for (const v of victims) v.parent.remove(v);
  const baked = new THREE.Group(); baked.name = 'baked';
  for (const { mat, geos } of groups.values()) {
    const merged = mergeGeometries(geos, false);
    if (!merged) continue;
    merged.computeBoundingSphere();
    baked.add(new THREE.Mesh(merged, mat));
  }
  // меши уже в мировых координатах — добавляем в сцену без смещения
  root.parent.add(baked);
}
